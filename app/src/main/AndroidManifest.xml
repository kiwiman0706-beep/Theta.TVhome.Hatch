<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- テレビ用。タッチ画面は要らない -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ホーム画面：入っているアプリの一覧 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- 更新のハブ（spec §6.1）：TV では TVhome がハブ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- シリーズ共通の鍵で署名したアプリだけが使える窓口（設定のハブ・UPDATE_BUSY） -->
    <permission
        android:name="app.thetahatch.permission.SHARE"
        android:protectionLevel="signature" />
    <uses-permission android:name="app.thetahatch.permission.SHARE" />

    <application
        android:name=".TvHomeApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ホームアプリとして（既定のホームにするのは ADB か設定で） -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.thetahatch.HATCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ほかのアプリの「更新する」：Intent("app.thetahatch.action.UPDATE")（spec §6.1） -->
        <activity
            android:name=".hub.UpdateActivity"
            android:exported="true"
            android:theme="@style/Theme.TvHome">
            <intent-filter>
                <action android:name="app.thetahatch.action.UPDATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- レスキュー：ホームが落ち続ける・固まったときの画面。本体と別のプロセス。テレビのアプリ一覧からも開ける -->
        <activity
            android:name=".rescue.RescueActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="TVhome のレスキュー"
            android:process=":rescue"
            android:taskAffinity="app.thetahatch.tvhome.rescue"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- いま再生中のもの（メディアセッション）を読むための入口。許可は ADB（docs/ADB.md） -->
        <service
            android:name=".media.MediaListener"
            android:exported="true"
            android:label="TVhome の再生中の表示"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".hub.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".hub.BusyReceiver"
            android:exported="true"
            android:permission="app.thetahatch.permission.SHARE">
            <intent-filter>
                <action android:name="app.thetahatch.action.UPDATE_BUSY" />
            </intent-filter>
        </receiver>

        <!-- 設定のハブ（THETA_SHARED_SETTINGS §4.0）：content://app.thetahatch.tvhome.theta/ -->
        <provider
            android:name=".hub.SettingsProvider"
            android:authorities="app.thetahatch.tvhome.theta"
            android:exported="true"
            android:permission="app.thetahatch.permission.SHARE" />

        <!-- ADB の窓口（THETA_ADB_SPEC §3）。DUMP 権限なので adb の shell からだけ -->
        <service
            android:name="app.thetahatch.adb.StatusService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedService" />
        <receiver
            android:name="app.thetahatch.adb.CommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.thetahatch.adb.GET" />
                <action android:name="app.thetahatch.adb.SET" />
                <action android:name="app.thetahatch.adb.SET_SECRET" />
                <action android:name="app.thetahatch.adb.OPEN" />
                <action android:name="app.thetahatch.adb.LAUNCH" />
                <action android:name="app.thetahatch.adb.PROBE" />
                <action android:name="app.thetahatch.adb.CHECK_UPDATE" />
                <action android:name="app.thetahatch.adb.UPDATE" />
            </intent-filter>
        </receiver>

        <!-- WorkManager の初期化は TvHomeApp で行う（起動を軽く） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
